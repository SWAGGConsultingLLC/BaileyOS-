# Public (safe in the browser)
NEXT_PUBLIC_ORIGIN_LAT=39.0639      # downtown Grand Junction (approx Main & 5th)
NEXT_PUBLIC_ORIGIN_LON=-108.5506
NEXT_PUBLIC_MAX_KM=50
NEXT_PUBLIC_BAND_KM=5
NEXT_PUBLIC_SECTOR_DEG=30
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # only used for optional login

# Server only. Never expose these.
SUPABASE_SERVICE_ROLE_KEY=
PLACEMENT_SECRET=                   # long random string: openssl rand -hex 32
CRON_SECRET=                        # for /api/retention
DEDUPE_WINDOW_HOURS=24
RETENTION_DAYS=90

# Main project age-gate log (click and dwell). Server only. Do not touch age_verifications.
# Leave blank in git. The map still runs if these are empty.
AGE_GATE_SUPABASE_URL=
AGE_GATE_ANON_KEY=
