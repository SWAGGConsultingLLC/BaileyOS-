# Prefilled map center for project "BaileyOS Signal Finder Compass". Copy to .env.local.
# Do not commit .env.local. Do not put a service-role key in this file.
NEXT_PUBLIC_ORIGIN_LAT=39.0639
NEXT_PUBLIC_ORIGIN_LON=-108.5506
NEXT_PUBLIC_MAX_KM=50
NEXT_PUBLIC_BAND_KM=5
NEXT_PUBLIC_SECTOR_DEG=30
NEXT_PUBLIC_SUPABASE_URL=https://rxckxwdvhjszzuqsvxdk.supabase.co
# Publishable key from Supabase → Project Settings → API. Leave blank in git.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 360° Brewing sign-in uses the map project above and Supabase's LinkedIn (OIDC) provider.
# The Data Nest project is not used for this button. Do not put a service-role key here.
NEXT_PUBLIC_SUITE_SUPABASE_URL=
NEXT_PUBLIC_SUITE_PUBLISHABLE_KEY=

# Fill these two yourself. Never commit them.
SUPABASE_SERVICE_ROLE_KEY=
PLACEMENT_SECRET=
CRON_SECRET=
DEDUPE_WINDOW_HOURS=24
RETENTION_DAYS=28

# Main project age-gate log (click and dwell). Server only. Do not touch age_verifications.
# Leave blank in git. The map still runs if these are empty.
AGE_GATE_SUPABASE_URL=
AGE_GATE_ANON_KEY=
